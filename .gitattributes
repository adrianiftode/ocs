# Normalize to LF in the repository.
* text=auto

# Shell scripts must keep LF even when checked out on Windows,
# otherwise the shebang breaks ("bad interpreter").
ocs       text eol=lf
*.sh      text eol=lf
*.py      text eol=lf

# Windows-native scripts stay CRLF.
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.ps1     text eol=crlf
